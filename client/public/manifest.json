{
  "manifest_version": 3,
  "name": "InsightForge Debug Collector",
  "version": "1.0.0",
  "description": "A lightweight and professional debug collector for InsightForge. Captures console logs, errors, and environment information.",
  "author": "Your Name",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "InsightForge Debug Collector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["debug-collector.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["debug-collector.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
